{
  "name": "browndust2-model-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "React + Vite viewer for BrownDust 2 Spine models in model-library/",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:home": "node scripts/build-home.mjs",
    "build:we": "node scripts/build-home.mjs && node scripts/deploy-weproject.mjs",
    "build:we:embed": "node scripts/build-home.mjs --embed && node scripts/deploy-weproject.mjs",
    "deploy:we": "node scripts/deploy-weproject.mjs",
    "project:gen": "node scripts/gen-project.mjs",
    "project:check": "node scripts/gen-project.mjs --check",
    "verify:embed": "node scripts/verify-embed.mjs",
    "preview": "vite preview",
    "model:list": "node scripts/scan-model-library.mjs",
    "backdrops:ids": "node scripts/backdrops.mjs ids",
    "backdrops:add": "node scripts/backdrops.mjs add",
    "backdrops:prune": "node scripts/backdrops.mjs prune"
  },
  "dependencies": {
    "@esotericsoftware/spine-webgl": "4.1.56",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "wallkit": "github:mikoberry/wallkit#a15df5e5f54fd7fee0a70a0cfe72c7f782d6707d"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  }
}
